# ============================================================
#  GraphRAG – Variables de entorno para Docker
#
#  1. Copia este archivo:  cp .env.docker .env
#  2. Ajusta las credenciales que quieras cambiar
#  3. Provee tu LLM_GATEWAY_URL (servicio externo)
#  4. docker compose up --build
#
#  Para Whisper con GPU Nvidia:
#    docker compose --profile gpu up --build
#  Para Whisper solo CPU:
#    docker compose --profile cpu up --build
# ============================================================

ENV_STATE=dev

# ── FastAPI ──────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── PostgreSQL ───────────────────────────────────────────────
# En Docker, el host es el nombre del servicio "postgres"
# (docker-compose lo inyecta automáticamente)
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=rag_password
POSTGRES_DB=rag_orchestrator

# ── Redis ────────────────────────────────────────────────────
REDIS_DB=0

# ── Neo4j ────────────────────────────────────────────────────
NEO4J_USER=neo4j
NEO4J_PASSWORD=s3cr3t2012

# ── Weaviate ─────────────────────────────────────────────────
WEAVIATE_GRPC_PORT=50051

# ── MinIO ────────────────────────────────────────────────────
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=mi_password_seguro
MINIO_BUCKET=rag-dataset

# ── LLM Gateway (SERVICIO EXTERNO) ───────────────────────────
# Cambia esta URL a la dirección de tu gateway LLM
LLM_GATEWAY_URL=http://host.docker.internal:8765
